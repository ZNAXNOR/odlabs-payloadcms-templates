{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@payload-config": [
        "./dev/payload.config.ts"
      ],
      "@/*": [
        "./dev/src/*"
      ],
      "odlabs-payload-plugin-template": [
        "./src/index.ts"
      ],
      "odlabs-payload-plugin-template/client": [
        "./src/exports/client.ts"
      ],
      "odlabs-payload-plugin-template/rsc": [
        "./src/exports/rsc.ts"
      ]
    },
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "rootDir": "./",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "target": "ES2022",
    "composite": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./dev/**/*.ts",
    "./dev/**/*.tsx",
    "./dev/**/*.js",
    "./dev/**/*.jsx",
    "./dev/next-env.d.ts",
    ".next/dev/types/**/*.ts"
  ]
}
